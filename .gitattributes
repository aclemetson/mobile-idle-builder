# Unity YAML assets — keep LF in the repo, no CRLF conversion
*.asset        text eol=lf
*.unity        text eol=lf
*.prefab       text eol=lf
*.meta         text eol=lf
*.asmdef       text eol=lf
*.asmref       text eol=lf
*.shader       text eol=lf
*.cginc        text eol=lf
*.hlsl         text eol=lf
*.inputactions text eol=lf

# Source and config — normalise to LF
*.cs           text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.md           text eol=lf
*.html         text eol=lf
*.txt          text eol=lf

# Binaries — never diff or convert
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.psd          binary
*.tga          binary
*.tif          binary
*.tiff         binary
*.bmp          binary
*.exr          binary
*.hdr          binary
*.fbx          binary
*.obj          binary
*.wav          binary
*.mp3          binary
*.ogg          binary
*.mp4          binary
*.dll          binary
*.so           binary
*.a            binary
*.lib          binary
*.keystore     binary
