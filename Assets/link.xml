<linker>
  <!-- Preserve Google Sign-In plugin from IL2CPP managed stripping -->
  <assembly fullname="Google.SignIn" preserve="all"/>

  <!-- Preserve UGS assemblies used via async/reflection paths.

       Analytics serialises arbitrary event parameters inside an async upload task, making it the most
       reflection-dependent of these and the most fragile under IL2CPP managed stripping. Omitting it is
       invisible at every layer the client can see: RecordEvent only enqueues and returns true, Flush only
       starts the upload and returns ok, and the upload then throws on a Task nobody awaits. Unity does not
       log unobserved Task exceptions, so the game reports success, logcat stays empty, and nothing reaches
       the dashboard. That is exactly what happened when analytics was added without being listed here: the
       editor (Mono, no stripping) worked throughout while every device build silently dropped every event.

       NOTE: an XML comment may not contain a double hyphen. Use the word, not the punctuation. A stray one
       here crashes UnityLinker with "Fatal error in Unity CIL Linker" and fails the Android build. -->
  <assembly fullname="Unity.Services.Core" preserve="all"/>
  <assembly fullname="Unity.Services.Authentication" preserve="all"/>
  <assembly fullname="Unity.Services.CloudSave" preserve="all"/>
  <assembly fullname="Unity.Services.Analytics" preserve="all"/>

  <!-- Added for Medium managed stripping (#207). Medium strips far more than Minimal, which is what makes
       libil2cpp.so smaller, so everything the game reaches through reflection, JSON or SDK registration
       is kept whole. Most of the saving then comes from the base class libraries and the engine modules.
       Rule of thumb: an SDK that works in the Editor but fails silently on a device build is a missing
       entry here. ignoreIfMissing keeps a platform-only assembly (iOS notifications on Android) from
       failing the link. -->

  <!-- Services core: packages register themselves with the core registry at startup. -->
  <assembly fullname="Unity.Services.Core.Analytics" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Components" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Configuration" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Device" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Environments" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Environments.Internal" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Internal" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Networking" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Registration" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Scheduler" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Telemetry" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.Core.Threading" preserve="all" ignoreIfMissing="1"/>

  <!-- Remote Config (JsonUtility response DTOs), Cloud Code (Newtonsoft request/response DTOs for the PvE
       module), push, crash reports. -->
  <assembly fullname="Unity.Services.RemoteConfig" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.CloudCode" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.PushNotifications" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Services.CloudDiagnostics" preserve="all" ignoreIfMissing="1"/>

  <!-- Store, ads and notification SDKs: callbacks arrive from Java/Objective-C by name. -->
  <assembly fullname="Unity.Purchasing" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Purchasing.Stores" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Purchasing.Security" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Purchasing.SecurityCore" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Purchasing.Utilities" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.LevelPlay" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Notifications.Android" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Notifications.iOS" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Notifications.Unified" preserve="all" ignoreIfMissing="1"/>

  <!-- ECS: TypeManager discovers component and system types by reflection at world creation. -->
  <assembly fullname="Unity.Entities" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Entities.Hybrid" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Transforms" preserve="all" ignoreIfMissing="1"/>

  <!-- The game itself: save data, game data and Cloud Code DTOs go through JsonUtility and Newtonsoft,
       and services self-bootstrap via RuntimeInitializeOnLoadMethod. -->
  <assembly fullname="MobileIdleBuilder" preserve="all" ignoreIfMissing="1"/>
</linker>
