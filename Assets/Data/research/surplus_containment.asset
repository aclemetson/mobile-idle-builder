  id: surplus_containment
  displayName: Surplus Containment
  description: Unlock Output Capacity upgrades on every building, so automated production
    keeps stockpiling instead of stalling when output buffers fill.
  icon: {fileID: 0}
  branch: 3
  prerequisites:
