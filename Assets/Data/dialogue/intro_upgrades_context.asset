  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_upgrades_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Before you start saving \u2014 your factory is running at base efficiency.
      Every building here can be upgraded on two separate tracks: Speed and Storage."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Speed upgrades multiply throughput. Level 2 doubles your production rate.
      Level 4 brings you to eight times the base. Same inputs, same power draw \u2014
      delivered faster."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Storage upgrades expand the output buffer \u2014 how many items a building
      holds before it stalls. A larger buffer means the factory keeps running longer
      while you are away."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Tap the Atom Generator. We are upgrading its speed first \u2014 it is
      the bottleneck of your hydrogen line."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: atomic_assembler
    action: 
