  m_Name: particles_loop_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: 'Alpha and Beta particles are the debris of nuclear instability. What is
      a hazard anywhere else is a resource here: sell them at Maxwell''s Demon.'
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "You have built matter from nothing \u2014 quarks to nucleons, nucleons
      to atoms, atoms to isotopes, isotopes to fissile fuel. This is the current
      frontier of the Quantum Foundry. The next tier of synthesis is ahead. Keep
      building."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
