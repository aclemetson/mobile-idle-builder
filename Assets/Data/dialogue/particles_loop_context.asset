  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: particles_loop_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Alpha and Beta particles \u2014 secondary energy currency, harvested from
      nuclear instability. What is a hazard in any other context is a resource here.
      Your Containment building converts decay into power."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "You have built matter from nothing \u2014 quarks to nucleons, nucleons
      to atoms, atoms to isotopes, isotopes to fissile fuel. This is the current
      frontier of the Quantum Foundry. The next tier of synthesis is ahead. Keep
      building."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
