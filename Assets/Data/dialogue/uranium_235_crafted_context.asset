  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: uranium_235_crafted_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: Uranium-235. Enriched nuclear fuel, worth twice ordinary Uranium, and enrichment
      releases three spare neutrons you can put to work elsewhere.
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Split it in a Fission Reactor and it becomes two lighter elements worth
      several times the fuel, plus neutrons for capture. The alpha particles your
      Decay Chamber releases sell at Maxwell's Demon.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
