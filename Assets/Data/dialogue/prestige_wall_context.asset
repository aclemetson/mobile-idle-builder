  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "You have reached the ceiling. Prestige is not failure \u2014 it is the
      mechanism that converts one-time progress into permanent power."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "The reset clears your inventory, buildings, and entropy. What you keep:
      prestige currency and a research memory discount on nodes you have already
      unlocked. Initiate it \u2014 you will return faster than you left."
    portrait: {fileID: 0}
