  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: uranium_crafted_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Uranium. 1,000 entropy for a single atom. This is the endpoint of stellar
      fusion \u2014 stars cannot forge anything heavier than iron without consuming
      more energy than they produce. What you just built required conditions found
      only in supernovae."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "It is also radioactive. Its isotopes \u2014 particularly Uranium-235 \u2014
      are where things become truly interesting. That requires Isotope Engineering."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
