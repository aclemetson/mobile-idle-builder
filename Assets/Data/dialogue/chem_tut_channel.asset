  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: chem_tut_channel
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: 'Now draw a Channel from the tile below the Spring straight to the Calorimeter''s
      side. That is your stream: it carries whatever is dropped into it down to the
      Calorimeter.'
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: 'Remember this: the stream runs past buildings, in front of them, never
      into them. Everything you build goes beside the water.'
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
