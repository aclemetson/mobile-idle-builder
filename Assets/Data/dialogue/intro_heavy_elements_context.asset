  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_heavy_elements_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: 'Heavy Elements research teaches the Atom Generator to build Uranium: 92
      protons, 146 neutrons, 92 electrons. Atomic mass 238. One atom takes nearly
      four minutes and sells for 64 entropy.'
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: 'Uranium is not worth building for its own sake. It is where the decay
      chain begins: Radioactive Isotopes lets it decay step by step down to Lead,
      and every step is worth more than the last.'
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
