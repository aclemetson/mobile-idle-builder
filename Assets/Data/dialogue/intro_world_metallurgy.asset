  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_world_metallurgy
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: 'Life is complete, and it needs tools. Deep in the crust the elements you
      forged lie as ores: iron in hematite, copper in chalcopyrite, aluminium in
      bauxite, titanium in rutile.'
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Metallurgy is open. Travel there from the Worlds panel. Smelt ores into
      steel and alloys, and the alloys into the materials a megastructure needs.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
