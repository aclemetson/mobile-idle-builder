  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: atomic_assembly_unlocked_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Nucleosynthesis is active. Helium-4 is now craftable \u2014 two protons,
      two neutrons, two electrons. It sells for ten entropy, twice hydrogen, so on
      its own it earns no more. Its real value is as fuel for something far bigger.
      First, move your neutron belt off the Demon and into the Atom Generator. Then
      set the Atom Generator to Helium-4."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Helium-4 is as far as the Atom Generator goes. Every heavier element must
      be fused from lighter ones, and that road starts with Helium.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
