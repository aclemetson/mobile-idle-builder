  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_world_biology
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: 'From dead chemistry, something new: matter that copies itself. Biology
      takes the organic precursors you have learned to make and assembles them into
      the machinery of life.'
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Harvest organic compounds from the living fields, build biomolecules,
      then cells, tissues, organs \u2014 and at last a whole ecosystem. This is the
      summit of the journey: from quarks to a living world."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
