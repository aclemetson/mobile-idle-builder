  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_automation_i
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "That entropy unlocks Automation I. A Field Collector \u2014 a Harvester
      placed directly on a quantum field \u2014 gathers particles automatically on
      a continuous cycle. No tapping required."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: This is the transition point. Manual harvesting was a lesson. The Field
      Collector is how you scale.
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Open the Build menu and place a Harvester on the quark or lepton field.
      Once it is running, the facility collects without you.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
