  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_isotopes_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "An element's identity is its proton count. Its isotope is its neutron
      count. Change the neutrons and you change the nuclear behavior \u2014 mass,
      stability, decay mode \u2014 without changing the element itself."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "The Isotopic Manipulator adds or removes neutrons from a base element.
      It runs at half the speed of the Atom Generator \u2014 neutron adjustment is
      precise work. Deuterium, Tritium, and Carbon-14 all unlock here."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
