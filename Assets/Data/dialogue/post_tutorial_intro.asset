  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: post_tutorial_intro
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Your factory runs on its own. Hydrogen flows from quark to atom to entropy
      \u2014 that is the foundation. Everything that follows builds on this loop."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "The Research panel shows your next frontier. Atomic Assembly opens the
      rest of the periodic table \u2014 but it costs five hundred entropy. Let the
      factory accumulate it."
