  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: recombination_unlocked_dialogue
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Recombination I is active. The strong nuclear force is now at your disposal
      \u2014 the most powerful fundamental force in nature, and the one that makes
      atomic structure possible."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "A proton is two Up Quarks and one Down Quark \u2014 net charge +1, the
      core of every hydrogen atom. A neutron is one Up Quark and two Down Quarks
      \u2014 net charge zero, the stabilizing mass inside every nucleus beyond hydrogen."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
