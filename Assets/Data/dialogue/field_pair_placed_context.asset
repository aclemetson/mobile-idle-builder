  m_Name: field_pair_placed_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: A second pair. Put a Harvester on each, Up and Down, and feed them into
      a second Strong Force Combiner set to Neutron.
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Protons from one Combiner, neutrons from the other, electrons from your
      lepton field. That is everything helium needs, once Atomic Assembly teaches
      your Atom Generator to make it.
    portrait: {fileID: 0}
    pauseGame: 0
