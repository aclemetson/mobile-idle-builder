  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_architect
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Welcome. I am The Architect \u2014 your guide through the Quantum Foundry.
      This facility builds matter from scratch, starting with the smallest particles
      in existence."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Everything solid in the universe \u2014 planets, stars, you \u2014 began
      as fundamental particles. Your job is to harvest them, combine them, and build
      upward."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "See that glowing blue field? That is a Lepton Field \u2014 saturated with
      free electrons. Every atom you will ever build needs them."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: electron_field
    action: 
  - speakerName: The Architect
    text: Tap it. Pull electrons into your inventory.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: electron_field
    action: pulse_field
