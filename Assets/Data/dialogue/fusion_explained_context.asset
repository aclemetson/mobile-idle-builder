  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: fusion_explained_context
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Every fusion turns a sliver of mass into energy. It leaves the reactor
      as particles \u2014 gamma rays, neutrinos \u2014 that pass straight through
      your walls. Each one that escapes is paid out as bonus entropy."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: 'Feed the reactor Deuterium and it makes Helium. A second reactor fed that
      Helium makes Carbon: three Helium-4 for one Carbon, worth 160 entropy.'
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
