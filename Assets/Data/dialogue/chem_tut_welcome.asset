  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: chem_tut_welcome
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: 'Welcome to the lab. Chemistry plays by different rules: there is no power
      here, and no Maxwell''s Demon. Water does the work.'
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Every reaction is an equation. Two hydrogen and one oxygen make two water,
      nitrogen and three hydrogen make two ammonia. Your buildings follow those recipes
      exactly.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
