  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: intro_quantum_domains
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: "Materials Science opens a new frontier. Until now you have built within
      a single Quantum Domain \u2014 but the foundry can anchor to others."
    portrait: {fileID: 0}
    pauseGame: 1
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Each Domain is its own build site, with a separate grid and field distribution.
      The Quark Sea teems with quark fields; the Lepton Storm runs thick with electrons.
      Anchoring to one costs entropy, but the unlock never expires \u2014 not even
      through prestige."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: "Open the menu and tap Domains to survey what is within reach. An inactive
      Domain keeps producing while you work elsewhere \u2014 collected the next time
      you return to it."
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
