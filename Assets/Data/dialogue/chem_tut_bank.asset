  m_Script: {fileID: 11500000, guid: c8d1a109e3f4550607082930a1a2b3c4, type: 3}
  m_Name: chem_tut_bank
  m_EditorClassIdentifier: MobileIdleBuilder::MobileIdleBuilder.DialogueSO
  lines:
  - speakerName: The Architect
    text: Now a reaction. Buildings sit on the bank of the stream. As items float
      past, each one takes only what its recipe needs and lets everything else flow
      on, then drops what it makes back into the water.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
  - speakerName: The Architect
    text: Place a Molecular Synthesizer with its bank side on the channel, downstream
      of your Extractors, so the gases reach it.
    portrait: {fileID: 0}
    pauseGame: 0
    highlightTarget: 
    action: 
