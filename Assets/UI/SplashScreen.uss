/* ================================================================
   SplashScreen.uss — Placeholder launch splash
   ================================================================ */

@import url("tokens.uss");

.splash-root {
    flex-grow: 1;
    background-color: var(--color-background);
    align-items: center;
    justify-content: center;
}

.splash-content {
    align-items: center;
    opacity: 0;   /* faded in by SplashScreenController */
}

.splash-title {
    font-size: 52px;
    color: var(--color-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}

.splash-subtitle {
    font-size: 52px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-top: -8px;
}

.splash-rule {
    width: 120px;
    height: 2px;
    background-color: var(--color-primary);
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}

.splash-tagline {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.splash-version {
    position: absolute;
    bottom: var(--spacing-md);
    right: var(--spacing-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    opacity: 0;   /* faded in by SplashScreenController */
}

/* ---- Maintenance overlay (shown in place of splash-content when under maintenance) ---- */

.maintenance-panel {
    align-items: center;
    justify-content: center;
    max-width: 480px;
    padding-left: var(--spacing-lg);
    padding-right: var(--spacing-lg);
}

.maintenance-panel.hidden {
    display: none;
}

.maintenance-title {
    font-size: 32px;
    color: var(--color-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: var(--spacing-md);
}

.maintenance-message {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--spacing-sm);
}

.maintenance-time {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
    margin-bottom: var(--spacing-lg);
}

.maintenance-retry-btn {
    padding-top: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
    padding-left: var(--spacing-lg);
    padding-right: var(--spacing-lg);
    background-color: var(--color-primary);
    color: var(--color-background);
    border-radius: var(--border-radius);
    border-width: 0;
    font-size: var(--font-size-md);
    -unity-font-style: bold;
}
