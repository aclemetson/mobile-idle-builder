<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="tokens.uss" />
    <Style src="SplashScreen.uss" />

    <ui:VisualElement name="splash-root" class="splash-root">

        <ui:VisualElement name="splash-content" class="splash-content">
            <ui:Label name="splash-title"    text="QUANTUM FOUNDRY"          class="splash-title" />
            <ui:VisualElement                                                  class="splash-rule" />
            <ui:Label name="splash-tagline"  text="Build. Collapse. Repeat." class="splash-tagline" />
        </ui:VisualElement>

        <ui:VisualElement name="maintenance-panel" class="maintenance-panel hidden">
            <ui:Label  name="maintenance-title"   text="Under Maintenance" class="maintenance-title" />
            <ui:Label  name="maintenance-message" text=""                  class="maintenance-message" />
            <ui:Label  name="maintenance-time"    text=""                  class="maintenance-time" />
            <ui:Button name="btn-maintenance-retry" text="Retry"           class="maintenance-retry-btn" />
        </ui:VisualElement>

        <ui:Label name="splash-version" text="" class="splash-version" />

    </ui:VisualElement>
</ui:UXML>
