/* ================================================================
   LoadingScreen.uss — Async scene transition loading screen
   ================================================================ */

@import url("tokens.uss");

.loading-root {
    flex-grow: 1;
    background-color: var(--color-background);
    align-items: center;
    justify-content: center;
}

.loading-content {
    width: 60%;
    align-items: center;
}

.loading-label {
    font-size: var(--font-size-xl);
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-md);
    -unity-text-align: middle-center;
}

.loading-progress {
    width: 100%;
    height: 20px;
    margin-bottom: var(--spacing-sm);
}

/* Progress bar fill — targets the internal fill element generated by ProgressBar */
.loading-progress > .unity-progress-bar__background {
    background-color: var(--color-surface);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--border-radius);
}

.loading-progress > .unity-progress-bar__progress {
    background-color: var(--color-primary);
    border-radius: var(--border-radius);
}

/* Hide the built-in title label; we use our own percent-label below */
.loading-progress > .unity-progress-bar__title {
    display: none;
}

.percent-label {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
}
