/* ================================================================
   LoadingScreen.uss — Async scene transition loading screen
   ================================================================ */

@import url("tokens.uss");

.loading-root {
    flex-grow: 1;
    background-color: var(--color-background);
    align-items: center;
    justify-content: center;
}

.loading-content {
    width: 60%;
    align-items: center;
}

.loading-label {
    font-size: var(--font-size-xl);
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-md);
    -unity-text-align: middle-center;
}

.loading-progress {
    width: 100%;
    height: 20px;
    margin-bottom: var(--spacing-sm);
}

/* Progress bar fill — targets the internal fill element generated by ProgressBar */
.loading-progress > .unity-progress-bar__background {
    background-color: var(--color-surface);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--border-radius);
}

.loading-progress > .unity-progress-bar__progress {
    background-color: var(--color-primary);
    border-radius: var(--border-radius);
}

/* Hide the built-in title label; we use our own percent-label below */
.loading-progress > .unity-progress-bar__title {
    display: none;
}

.percent-label {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
}

/* Centered under the bar rather than in a screen corner, where curved phone edges clip it */
.loading-version {
    margin-top: var(--spacing-md);
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
}

/* ── Save choice at startup (SaveConflictPrompt.cs, loading-screen host) ─── */
.hidden {
    display: none;
}

.ls-save-choice {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.ls-save-choice__card {
    width: 88%;
    max-width: 560px;
    padding: var(--spacing-md);
    background-color: var(--color-surface);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: 12px;
}

.ls-save-choice__title {
    font-size: var(--font-size-xl);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    margin-bottom: var(--spacing-sm);
}

.ls-save-choice__message {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: var(--spacing-md);
}

.ls-save-choice__option {
    flex-direction: column;
    align-items: stretch;
    padding: var(--spacing-sm) var(--spacing-md);
    margin: 0 0 var(--spacing-sm) 0;
    min-height: 72px;
    background-color: var(--color-surface-raised);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--border-radius);
}

.ls-save-choice__option-title {
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
    color: var(--color-primary);
    -unity-text-align: middle-left;
}

.ls-save-choice__option-summary {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    white-space: normal;
    -unity-text-align: middle-left;
    margin-top: var(--spacing-xs);
}

.ls-save-choice__buttons {
    flex-direction: row;
    justify-content: space-between;
}

.ls-save-choice__btn {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 56px;
    margin: 0 var(--spacing-xs);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    color: var(--color-background);
    background-color: var(--color-primary);
    border-width: 0;
    border-radius: var(--border-radius);
}

.ls-save-choice__btn--secondary {
    color: var(--color-text-primary);
    background-color: var(--color-surface-raised);
    border-color: var(--color-border);
    border-width: 1px;
}
