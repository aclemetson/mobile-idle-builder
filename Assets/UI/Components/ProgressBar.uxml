<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
        ProgressBar — reusable fill bar for crafting progress, XP, research, upgrades.
        Clone in C# via VisualTreeAsset.Instantiate(), then:
          - progress-bar__label  set text or hide (add .hidden)
          - progress-bar__fill   set style.width to a Length percentage (0–100%)
          - progress-bar__fill   swap colour modifier class (warning / danger / success)
    -->
    <Style src="../tokens.uss" />
    <Style src="../components.uss" />

    <ui:VisualElement name="progress-bar" class="progress-bar">
        <ui:Label name="progress-bar__label" text="" class="progress-bar__label hidden" />
        <ui:VisualElement name="progress-bar__track" class="progress-bar__track">
            <ui:VisualElement name="progress-bar__fill" class="progress-bar__fill" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
