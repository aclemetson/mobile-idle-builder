/* ================================================================
   GameHUD.uss — HUD component styles for Mobile Idle Builder
   Design tokens are defined in tokens.uss — do not hardcode values here.
   ================================================================ */

/* ---- Root ---- */
.root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0); /* transparent — world renders behind */
}

/* ---- Top bar ---- */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: rgba(10, 14, 26, 0.88);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    min-height: 48px;
}

.inventory-bar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.inventory-item {
    color: var(--color-text-primary);
    font-size: var(--font-size-lg);
    margin-right: var(--spacing-md);
    -unity-font-style: bold;
}

.power-label {
    color: var(--color-warning);
    font-size: var(--font-size-lg);
    margin-left: var(--spacing-sm);
}

/* ---- Top bar buttons ---- */
.prestige-btn {
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(0, 230, 118, 0.12);
    border-color: var(--color-success);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-success);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    display: none; /* hidden until prestige threshold is met — C# toggles display */
}

.prestige-btn:hover {
    background-color: rgba(0, 230, 118, 0.24);
}

.settings-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(255,255,255,0.06);
    border-color: var(--color-border);
    border-width: 1px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    -unity-text-align: middle-center;
    padding: 0;
    margin-left: var(--spacing-sm);
}

.settings-btn:hover {
    background-color: var(--color-surface-raised);
    border-color: var(--color-primary);
    color: var(--color-primary);
}

/* ---- Grid area (passthrough — touch events fall through to world) ---- */
.grid-area {
    flex-grow: 1;
    /* picking-mode: ignore is set via C# where needed */
}

/* ---- Left drawer ---- */

/* Full-height anchor column on the left edge — holds the handle, doesn't intercept input */
.drawer-handle-anchor {
    position: absolute;
    left: 0;
    top: var(--top-bar-height);
    bottom: 0;
    width: 44px;
    justify-content: center;
    align-items: flex-start;
}

.drawer-handle {
    width: 44px;
    height: 64px;
    background-color: rgba(10, 14, 26, 0.90);
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-left-width: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--color-border);
    color: var(--color-text-primary);
    font-size: var(--font-size-lg);
    -unity-text-align: middle-center;
    padding: 0;
}

.drawer-handle:hover {
    background-color: var(--color-surface-raised);
    border-color: var(--color-primary);
    color: var(--color-primary);
}

/* Semi-transparent backdrop behind the drawer — tap to close */
.drawer-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 45;
}

/* The drawer panel itself */
.left-drawer {
    position: absolute;
    left: 0;
    top: var(--top-bar-height); /* below top bar */
    bottom: 0;
    width: 260px;
    background-color: rgba(10, 14, 26, 0.97);
    border-right-width: 1px;
    border-right-color: var(--color-border);
    flex-direction: column;
    z-index: 50;
    translate: -260px 0;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.left-drawer--open {
    translate: 0px 0px;
}

.drawer-header {
    padding: var(--spacing-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    align-items: center;
}

.drawer-title {
    color: var(--color-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.drawer-section {
    padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xs);
}

.drawer-section-title {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs, 10px);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xs);
    padding: 0 var(--spacing-xs);
    letter-spacing: 1px;
}

/* Inventory items in the drawer */
.drawer-inventory {
    flex-direction: column;
}

.drawer-inventory-item {
    flex-direction: row;
    justify-content: space-between;
    padding: var(--spacing-xs) var(--spacing-sm);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
}

.drawer-divider {
    height: 1px;
    background-color: var(--color-border);
    margin: var(--spacing-xs) var(--spacing-sm);
}

.drawer-nav-scroll {
    flex-grow: 1;
    padding: 0 var(--spacing-sm) var(--spacing-sm);
}

/* Nav buttons in the drawer */
.drawer-nav-btn {
    width: 100%;
    margin-bottom: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: transparent;
    border-color: transparent;
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    -unity-text-align: middle-left;
}

.drawer-nav-btn:hover {
    background-color: rgba(0, 229, 255, 0.08);
    border-color: rgba(0, 229, 255, 0.2);
    color: var(--color-primary);
}

.drawer-nav-btn:active {
    background-color: rgba(0, 229, 255, 0.15);
}

/* Tutorial highlight — works on drawer-nav-btn via class addition */
.panel-btn--highlight {
    background-color: rgba(0, 229, 255, 0.20);
    border-color: var(--color-primary);
    border-width: 2px;
    color: var(--color-primary);
    -unity-font-style: bold;
}

/* Unlocked research card */
.research-card--unlocked {
    opacity: 0.55;
}

/* ---- Slide-up panel ---- */
.slide-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 65%;
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    flex-direction: column;
}

.hidden {
    display: none;
}

/* Full-screen overlay that blocks all input while dialogue is active */
.dialogue-blocker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ---- Panel header ---- */
.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.panel-title {
    color: var(--color-primary);
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
}

.close-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(255,255,255,0.06);
    border-color: var(--color-border);
    border-width: 1px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    -unity-text-align: middle-center;
    padding: 0;
}

.close-btn:hover {
    background-color: rgba(255, 23, 68, 0.18);
    border-color: var(--color-danger);
    color: var(--color-danger);
}

/* ---- Recipe list ---- */
.recipe-list {
    flex-grow: 1;
    padding: var(--spacing-sm);
}

.recipe-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
}

.recipe-info {
    flex-direction: column;
    flex-grow: 1;
}

.recipe-name {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
}

.recipe-inputs {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-top: 2px;
}

.recipe-row--locked {
    opacity: 0.5;
}

.recipe-lock-hint {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    -unity-font-style: italic;
}

.craft-btn {
    min-width: 64px;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(0, 229, 255, 0.12);
    border-color: var(--color-primary);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-primary);
    font-size: var(--font-size-md);
    -unity-text-align: middle-center;
}

.craft-btn:hover {
    background-color: rgba(0, 229, 255, 0.24);
}

.craft-btn:active {
    background-color: rgba(0, 229, 255, 0.36);
}

/* ---- Building cards ---- */
.building-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
}

.building-card-name {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    flex-grow: 1;
}

.building-card-recipe {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

/* ---- Placement overlay ---- */
.placement-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--top-bar-height); /* below top bar */
    bottom: 0;
    /* transparent — lets the world show through, pointer events pass to the grid */
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    justify-content: flex-start;
}

.placement-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: rgba(10, 14, 26, 0.82);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.placement-label {
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.cancel-placement-btn {
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(255, 23, 68, 0.14);
    border-color: var(--color-danger);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-danger);
    font-size: var(--font-size-sm);
}

.rotate-output-btn {
    padding: var(--spacing-xs) var(--spacing-sm);
    margin-right: var(--spacing-sm);
    background-color: rgba(0, 229, 255, 0.12);
    border-color: var(--color-primary);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
}
