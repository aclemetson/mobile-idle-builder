/* ================================================================
   GameHUD.uss — Design token system for Mobile Idle Builder HUD
   All colours, spacing and typography live here.
   ================================================================ */

/* ---- Design tokens ---- */
:root {
    --color-primary:        #00e5ff;
    --color-secondary:      #7c4dff;
    --color-background:     #0a0e1a;
    --color-surface:        #111827;
    --color-surface-raised: #1a2336;
    --color-text-primary:   #e0f7fa;
    --color-text-secondary: #546e7a;
    --color-warning:        #ffab00;
    --color-danger:         #ff1744;
    --color-success:        #00e676;
    --color-border:         #1e3a5f;

    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;

    --font-size-sm: 11px;
    --font-size-md: 14px;
    --font-size-lg: 18px;
    --font-size-xl: 24px;

    --border-radius: 4px;
    --panel-height:  60%;
}

/* ---- Root ---- */
.root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0); /* transparent — world renders behind */
}

/* ---- Top bar ---- */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: rgba(10, 14, 26, 0.88);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    min-height: 48px;
}

.inventory-bar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.inventory-item {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    margin-right: var(--spacing-md);
    -unity-font-style: bold;
}

.power-label {
    color: var(--color-warning);
    font-size: var(--font-size-md);
    margin-left: var(--spacing-sm);
}

/* ---- Grid area (passthrough — touch events fall through to world) ---- */
.grid-area {
    flex-grow: 1;
    /* picking-mode: ignore is set via C# where needed */
}

/* ---- Bottom bar ---- */
.bottom-bar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(10, 14, 26, 0.92);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    min-height: 56px;
}

.panel-btn {
    flex-grow: 1;
    margin: 0 var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-xs);
    background-color: var(--color-surface);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    -unity-text-align: middle-center;
}

.panel-btn:hover {
    background-color: var(--color-surface-raised);
    border-color: var(--color-primary);
    color: var(--color-primary);
}

.panel-btn:active {
    background-color: rgba(0, 229, 255, 0.12);
}

/* ---- Slide-up panel ---- */
.slide-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 56px;   /* sits above the bottom bar */
    height: var(--panel-height);
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    flex-direction: column;
}

.hidden {
    display: none;
}

/* ---- Panel header ---- */
.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.panel-title {
    color: var(--color-primary);
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
}

.close-btn {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgba(255,255,255,0.06);
    border-color: var(--color-border);
    border-width: 1px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    -unity-text-align: middle-center;
    padding: 0;
}

.close-btn:hover {
    background-color: rgba(255, 23, 68, 0.18);
    border-color: var(--color-danger);
    color: var(--color-danger);
}

/* ---- Recipe list ---- */
.recipe-list {
    flex-grow: 1;
    padding: var(--spacing-sm);
}

.recipe-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
}

.recipe-info {
    flex-direction: column;
    flex-grow: 1;
}

.recipe-name {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
}

.recipe-inputs {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-top: 2px;
}

.craft-btn {
    min-width: 64px;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(0, 229, 255, 0.12);
    border-color: var(--color-primary);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-primary);
    font-size: var(--font-size-md);
    -unity-text-align: middle-center;
}

.craft-btn:hover {
    background-color: rgba(0, 229, 255, 0.24);
}

.craft-btn:active {
    background-color: rgba(0, 229, 255, 0.36);
}

/* ---- Building cards ---- */
.building-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
}

.building-card-name {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    flex-grow: 1;
}

.building-card-recipe {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

/* ---- Placement overlay ---- */
.placement-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 48px;    /* below top bar */
    bottom: 56px; /* above bottom bar */
    /* transparent — lets the world show through, pointer events pass to the grid */
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    justify-content: flex-start;
}

.placement-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: rgba(10, 14, 26, 0.82);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.placement-label {
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.cancel-placement-btn {
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(255, 23, 68, 0.14);
    border-color: var(--color-danger);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-danger);
    font-size: var(--font-size-sm);
}
