/* ================================================================
   components.uss — Reusable UI component styles
   Covers: TierBadge, ItemSlot, ProgressBar, TooltipPopup,
           NotificationBanner, PanelContainer.
   Import tokens.uss before this file.
   ================================================================ */

@import url("tokens.uss");

/* Utility — usable in any UXML that imports components.uss */
.hidden { display: none; }

/* ================================================================
   TierBadge
   ================================================================ */

.tier-badge {
    padding: 1px var(--spacing-xs);
    border-radius: 3px;
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-width: 20px;
}

/* One modifier class per tier — set in C# via AddToClassList */
.tier-badge--0 { background-color: #2a2a2a; color: #9e9e9e; border-color: #444; border-width: 1px; }
.tier-badge--1 { background-color: #1b3a1b; color: #00e676; border-color: #00e676; border-width: 1px; }
.tier-badge--2 { background-color: #0d2d4a; color: #00e5ff; border-color: #00e5ff; border-width: 1px; }
.tier-badge--3 { background-color: #2a1b4a; color: #7c4dff; border-color: #7c4dff; border-width: 1px; }
.tier-badge--4 { background-color: #3a2800; color: #ffab00; border-color: #ffab00; border-width: 1px; }
.tier-badge--5 { background-color: #3a0d1b; color: #ff1744; border-color: #ff1744; border-width: 1px; }

/* ================================================================
   ItemSlot
   ================================================================ */

.item-slot {
    flex-direction: row;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
    min-width: 80px;
}

.item-slot__icon {
    width: 32px;
    height: 32px;
    margin-right: var(--spacing-xs);
    background-color: var(--color-surface);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
}

.item-slot__info {
    flex-direction: column;
    flex-grow: 1;
}

.item-slot__name {
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

.item-slot__quantity {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

/* ================================================================
   Item tile icons (periodic-table sprites in menus)
   ================================================================ */
/* Output-item icon shown on recipe rows / recipe-picker buttons. */
.item-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: var(--spacing-xs);
    -unity-background-scale-mode: scale-to-fit;
}

/* Smaller icon prefixed to each ingredient chip. */
.recipe-input-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Codex row: icon + name + entry text. */
.codex-row {
    flex-direction: row;
    align-items: center;
    padding: var(--spacing-sm);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
    margin-bottom: var(--spacing-xs);
}

.codex-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: var(--spacing-sm);
    -unity-background-scale-mode: scale-to-fit;
}

.codex-info {
    flex-direction: column;
    flex-grow: 1;
}

.codex-name {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
}

.codex-entry {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    white-space: normal;
}

/* ================================================================
   ProgressBar
   ================================================================ */

.progress-bar {
    flex-direction: column;
}

.progress-bar__label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-bottom: 2px;
}

.progress-bar__track {
    height: 6px;
    background-color: var(--color-surface);
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--color-border);
    overflow: hidden;
}

.progress-bar__fill {
    height: 100%;
    background-color: var(--color-primary);
    border-radius: 3px;
    /* width is set in C# as a percentage */
}

/* Colour modifiers — swap class in C# based on context */
.progress-bar__fill--warning { background-color: var(--color-warning); }
.progress-bar__fill--danger  { background-color: var(--color-danger); }
.progress-bar__fill--success { background-color: var(--color-success); }

/* ================================================================
   TooltipPopup
   ================================================================ */

.tooltip-popup {
    position: absolute;
    min-width: 180px;
    max-width: 260px;
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-primary);
    padding: var(--spacing-sm);
    flex-direction: column;
    /* position is set in C# based on the triggering element */
}

.tooltip-popup__title {
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tooltip-popup__body {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    white-space: normal;
}

/* ================================================================
   NotificationBanner
   ================================================================ */

.notification-banner {
    display: none;
    position: absolute;
    left: var(--spacing-md);
    right: var(--spacing-md);
    top: var(--top-bar-height); /* below top bar */
    flex-direction: row;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface-raised);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-success);
    translate: 0px -120px;
    transition-property: translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.notification-banner--shown {
    display: flex;
    translate: 0px 0px;
}

.notification-banner__icon {
    font-size: var(--font-size-lg);
    margin-right: var(--spacing-sm);
    color: var(--color-success);
}

.notification-banner__message {
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.notification-banner--warning { border-color: var(--color-warning); }
.notification-banner--warning .notification-banner__icon { color: var(--color-warning); }

.notification-banner--danger { border-color: var(--color-danger); }
.notification-banner--danger .notification-banner__icon { color: var(--color-danger); }

/* ================================================================
   FieldProximityBanner
   Persistent banner shown while the player is near a resource field.
   Sits above the bottom bar. Accent strip color is set in C# via
   inline style to match the field's identity color.
   ================================================================ */

.field-proximity-banner {
    position: absolute;
    left: var(--spacing-md);
    right: var(--spacing-md);
    bottom: 64px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(10, 14, 26, 0.88);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-border);
}

.field-proximity-banner__accent {
    width: 4px;
    /* background-color is set in C# to field.fieldColor */
}

.field-proximity-banner__body {
    flex-direction: column;
    padding: var(--spacing-sm) var(--spacing-md);
    flex-grow: 1;
}

.field-proximity-banner__name {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
}

.field-proximity-banner__type {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-top: 2px;
}

/* ================================================================
   TutorialHintBanner
   Persistent bottom banner that stays visible for the duration of a
   tutorial step. Hidden/shown in C# via HUDController.ShowTutorialHint /
   HideTutorialHint. Sits at the very bottom of the screen, below the
   demon panel (bottom: 10%) and below the dialogue box (bottom: 56px).
   z-index: 55 keeps it above the drawer (z-index: 50) when open.
   ================================================================ */

.tutorial-hint-banner {
    position: absolute;
    left: var(--spacing-md);
    right: var(--spacing-md);
    bottom: 4px;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: rgba(10, 14, 26, 0.92);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-primary);
    z-index: 55;
}

.tutorial-hint-banner__message {
    color: var(--color-primary);
    font-size: var(--font-size-md);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ================================================================
   OutputSelector
   Small overlay that appears when placing a Field Collector on a
   field with multiple harvestable output items.
   ================================================================ */

.output-selector {
    position: absolute;
    left: var(--spacing-lg);
    right: var(--spacing-lg);
    bottom: 72px;
    /* Cap the height so a long recipe list scrolls inside the panel instead of
       growing upward off the top of the screen (Atom Generator has 100+ recipes). */
    max-height: 60%;
    background-color: var(--color-surface);
    border-radius: var(--border-radius);
    border-width: 1px;
    border-color: var(--color-primary);
    padding: var(--spacing-md);
    flex-direction: column;
    align-items: stretch;
}

/* Compact top-right card for a selected power building (generator / relay) so the influence-radius
   ring drawn on the grid stays visible, instead of the full-width bottom slab covering it. The card
   sizes to its (small) content rather than the tall top-and-bottom flex layout the inspector uses for
   crafters, so its stats + upgrade sit tight with no empty scroll gap. */
.output-selector--power {
    left: auto;
    right: var(--spacing-lg);
    top: var(--top-bar-height);
    bottom: auto;
    width: 264px;
    height: auto;
    max-height: 70%;
    /* Tighter panel padding than the wide crafter panel so the narrow card has usable content width. */
    padding: var(--spacing-sm);
}

/* Power buildings have no recipes — drop the empty recipe scroll (and its stray divider). */
.output-selector--power .inspector-scroll--recipes {
    display: none;
}

/* Reclaim horizontal room: the stats block and the upgrade scroll add their own side padding on top
   of the panel padding, which in a narrow card clipped the upgrade name / cost / button. Zero their
   sides so only the panel padding (and the upgrade row's own inset) insets the content. */
.output-selector--power .inspector-static {
    padding-left: 0;
    padding-right: 0;
}

/* Size the upgrade block to its single row instead of collapsing to just the scrollbar arrows
   (flex-basis:0 only distributes height inside a top-and-bottom anchored panel; this card is
   content-sized). */
.output-selector--power .inspector-scroll--upgrades {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    padding-left: 0;
    padding-right: 0;
}

/* Trim the upgrade row's own side padding and let its title shrink so nothing clips at card width. */
.output-selector--power .upgrade-row {
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
}

.output-selector--power .upgrade-row-name {
    flex-shrink: 1;
}

/* Tighter header padding in the narrow card; the right pad reserves the corner ✕ zone so the full
   title ("Basic Generator") fits without ellipsizing. */
.output-selector--power .panel-header {
    padding: var(--spacing-sm);
    padding-right: 48px;
}

.output-selector--power .panel-title {
    font-size: var(--font-size-md);
}

/* Smaller corner ✕ for the compact card (position is inherited from the global absolute rule). */
.output-selector--power .close-btn {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    font-size: var(--font-size-md);
}

.output-selector__title {
    color: var(--color-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-sm);
    -unity-text-align: middle-center;
}

.output-selector__options {
    flex-direction: column;
    margin-bottom: var(--spacing-sm);
}

.output-option-btn {
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    background-color: rgba(0, 229, 255, 0.08);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--border-radius);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-text-align: middle-center;
}

.output-option-btn:hover {
    background-color: rgba(0, 229, 255, 0.2);
    border-color: var(--color-primary);
    color: var(--color-primary);
}
